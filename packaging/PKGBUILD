# Maintainer: UNBOUND Contributors <https://github.com/bobberdolle1/unbound>
# PKGBUILD for Arch Linux — UNBOUND CLI (Go + Zapret 2 nfqws2 + nftables)

pkgname=unbound-cli
pkgver=0.9.0
pkgrel=1
pkgdesc="Local L3/L4 DPI desynchronization CLI wrapping Zapret 2 nfqws2 with nftables/iptables management"
arch=('x86_64' 'aarch64')
url="https://github.com/bobberdolle1/unbound"
license=('GPL-3.0-only')
depends=('nftables' 'libnetfilter_queue')
makedepends=('go' 'nodejs' 'npm')
source=("unbound-${pkgver}.tar.gz::https://github.com/bobberdolle1/unbound/archive/refs/tags/v${pkgver}.tar.gz"
        "unbound.service")
sha256sums=('SKIP' 'SKIP')

build() {
    cd "${srcdir}/unbound-${pkgver}"
    (cd frontend && npm ci --no-audit --no-fund && npm run build)
    CGO_ENABLED=0 go build -trimpath \
        -ldflags="-s -w -X unbound/engine.Version=${pkgver} -X unbound/engine.BuildChannel=release" \
        -o unbound .
}

package() {
    cd "${srcdir}/unbound-${pkgver}"

    install -Dm755 "unbound" "${pkgdir}/usr/bin/unbound"
    ln -s unbound "${pkgdir}/usr/bin/unbound-cli"

    install -Dm644 "${srcdir}/unbound.service" \
        "${pkgdir}/usr/lib/systemd/system/unbound.service"

    install -Dm644 "LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "engine/third_party/ZAPRET2_LICENSE.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/ZAPRET2_LICENSE.txt"
    install -Dm644 "README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
