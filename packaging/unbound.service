# Systemd unit for UNBOUND headless Linux CLI (Zapret 2 nfqws2 + nftables/iptables).
# Interactive CLI Control Center can be launched manually via: sudo unbound --control
# Override the active profile via /etc/default/unbound (e.g. UNBOUND_PROFILE=discord).

[Unit]
Description=UNBOUND Local DPI Desynchronization Service
Documentation=https://github.com/bobberdolle1/unbound
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
Environment="UNBOUND_PROFILE=ultimate"
Environment="XDG_CONFIG_HOME=/var/lib/unbound"
EnvironmentFile=-/etc/default/unbound
ExecStart=/usr/bin/unbound --cli --profile ${UNBOUND_PROFILE}
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
StateDirectory=unbound
RuntimeDirectory=unbound
# ExtractAssets() stages SHA-256-verified nfqws2 and Lua scripts under /tmp/unbound-runtime-*
# and executes nfqws2 (which drops privileges via setuid/setgid). Keep /tmp writable and executable.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/tmp /var/tmp /run /var/lib/unbound
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
