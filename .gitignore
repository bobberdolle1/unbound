# ─── Compiled binaries ──────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.bin
*.sys

# The bundled bypass engine assets are *deliberately* versioned. Without these
# negations the rules above silently swallow `git add` for updated binaries.
!engine/core_bin/**
!engine/lists/**
!engine/lua_scripts/**
!engine/windivert.filter/**
!magisk-module/binaries/**

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/

# ─── Build output ───────────────────────────────────────────────────────────
build/bin/
dist/
release/
frontend/dist/
website/dist/
website/.astro/
target/
*.ipk
*.apk
*.aab

# ─── Test artifacts ─────────────────────────────────────────────────────────
*.test
test_bypass.exe
unbound-*.exe
unbound-*.zip
unbound-*.tar.gz
scripts/test-results/
test_output.txt
coverage.out
RELEASE_SUMMARY.txt

# ─── References & local docs ────────────────────────────────────────────────
reference/

# ─── Temporary files ────────────────────────────────────────────────────────
*.log
tmp/
zapdpi.txt
unbound_debug.log

# ─── Go ─────────────────────────────────────────────────────────────────────
go.work
go.work.sum

# ─── IDE / editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.kiro
.gemini

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
