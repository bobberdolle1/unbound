# ─── Compiled binaries ──────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.bin
*.sys
/unbound
unbound-linux-*
unbound-darwin-*

# The bundled bypass engine assets are *deliberately* versioned. Without these
# negations the rules above silently swallow `git add` for updated binaries.
!engine/core_bin/**
!engine/lists/**
!engine/lua_scripts/**

# ─── Dependencies & worktrees ───────────────────────────────────────────────
node_modules/
/.worktrees/
/website/

# ─── Build & packaging output ───────────────────────────────────────────────
build/bin/
/dist/
/release/
/.act-artifacts/
/RELEASE_MANIFEST.json
packaging/rpm-build/
packaging/deb-staging/
packaging/output/

frontend/package.json.md5
# Wails embeds frontend/dist, so `go build` fails on a clean clone unless the
# directory exists. Keep the placeholder, ignore everything Vite writes there.
frontend/dist/*
!frontend/dist/.gitkeep

# ─── Test & profiling artifacts ─────────────────────────────────────────────
*.test
test_bypass.exe
unbound-*.exe
unbound-*.zip
unbound-*.tar.gz
scripts/test-results/
test_output.txt
coverage.out
coverage*.out
*.prof
RELEASE_SUMMARY.txt

# ─── Local runtime state guards ─────────────────────────────────────────────
/autotune_vnext_*.json
/autotune_vnext_*.key

# ─── References & local docs ────────────────────────────────────────────────
reference/

# ─── Temporary files ────────────────────────────────────────────────────────
*.log
tmp/
zapdpi.txt
unbound_debug.log

# ─── Go ─────────────────────────────────────────────────────────────────────
go.work
go.work.sum

# ─── IDE / editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.kiro
.gemini

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
